# Server Setup
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication & Security
JWT_ACCESS_SECRET=local-development-secret-key-32-chars-long!
JWT_REFRESH_SECRET=local-development-refresh-secret-key-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=64616d656c6f63616c656e6372797074696f6e6b65796c6f63616c6465766b65

# Firebase Admin SDK Configuration (Production)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Emulators (Local Development)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# AI API Keys
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
PINECONE_API_KEY=pcsk_yourPineconeApiKeyHere
PINECONE_INDEX_NAME=gov-assist-index

# Optional: OpenAI Whisper (for voice transcription)
# OPENAI_API_KEY=sk-your-openai-key

# Optional: Google Cloud (for TTS and Translate)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Monitoring
# SENTRY_DSN=https://yourSentryDsnAddress@sentry.io/project

# Logging
LOG_LEVEL=debug

# Docs (disable in production)
ENABLE_DOCS=true
